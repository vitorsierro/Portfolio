# Copy to infra/hermes.env (git-ignored) and fill in.
#
# OBRIGATÓRIO: o Hermes se recusa a subir escutando fora do loopback sem
# autenticação, e em container o bind é sempre 0.0.0.0. Sem este token o
# container entra em loop de restart.
#   Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_AUTH_TOKEN=""

# NÃO habilite o basic auth do dashboard (HERMES_DASHBOARD_BASIC_AUTH_*): o
# nginx já exige a sessão do /admin antes de encostar no upstream, e um segundo
# prompt de senha quebraria justamente o login único. Essas variáveis existem
# para quem publica o dashboard sem proxy na frente.

# Daqui para baixo é opcional — sem isso o Hermes sobe, só não tem provedores
# nem canais conectados.
#
# AI provider (pick what you use)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Messaging channels — see the Hermes docs for the full list.
# TELEGRAM_BOT_TOKEN=""
# SLACK_BOT_TOKEN=""
