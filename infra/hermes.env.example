# Copy to infra/hermes.env (git-ignored) and fill in.
#
# OBRIGATÓRIO: o Hermes se recusa a subir escutando fora do loopback sem
# autenticação, e em container o bind é sempre 0.0.0.0. Sem este token o
# container entra em loop de restart.
#   Gere com: openssl rand -hex 32
#   (não conte com `node` no host da VPS — só existe dentro dos containers)
GATEWAY_AUTH_TOKEN=""

# OBRIGATÓRIO TAMBÉM: o dashboard se recusa a escutar fora do loopback sem
# provedor de auth próprio — não existe modo "bind público sem autenticação"
# (confirmado no log: "Refusing to bind dashboard to 0.0.0.0 ... no auth
# providers are registered"). O forward-auth do nginx não conta para essa
# checagem, que é interna ao processo. Sem isto o dashboard nunca abre a porta
# e o chat.vitorsierro.com cai em erro de upstream, mesmo com o container "up".
#
# Custa um segundo prompt de senha, além do login do /admin — o navegador
# guarda por origem, então na prática é uma vez por sessão. Gere a senha à
# parte (evite '+' '/' '=' e aspas — já mordemos um dotenv quebrado por byte
# especial) e o SECRET com: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=""
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=""
HERMES_DASHBOARD_BASIC_AUTH_SECRET=""

# Daqui para baixo é opcional — sem isso o Hermes sobe, só não tem provedores
# nem canais conectados.
#
# AI provider (pick what you use)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Messaging channels — see the Hermes docs for the full list.
# TELEGRAM_BOT_TOKEN=""
# SLACK_BOT_TOKEN=""
