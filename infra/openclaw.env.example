# Copy to infra/openclaw.env (git-ignored) and fill in.
#
# OBRIGATÓRIO: o OpenClaw se recusa a subir escutando fora do loopback sem
# autenticação, e em container o bind é sempre 0.0.0.0. Sem este token o
# container entra em loop de restart.
#   Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   Para abrir a Control UI: http://<host>/#token=<TOKEN>
OPENCLAW_GATEWAY_TOKEN=""

# Daqui para baixo é opcional — sem isso o OpenClaw sobe, só não tem
# provedores nem canais conectados.
#
# AI provider (pick what you use)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Messaging channels — see the OpenClaw docs for the full list.
# TELEGRAM_BOT_TOKEN=""
# SLACK_BOT_TOKEN=""
