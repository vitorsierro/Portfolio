# Copy to infra/.env on the VPS and fill in. Never commit the filled version.

# Origins allowed to send credentialed requests.
# The preview alias is same-site; never allow shared *.vercel.app origins.
# The wildcard is restricted to one label under the owned preview domain.
WEB_ORIGIN="https://vitorsierro.com,https://www.vitorsierro.com,https://preview.vitorsierro.com,https://*.preview.vitorsierro.com"

# Leading dot: shares the session cookie with the draw./chat. subdomains.
SESSION_COOKIE_DOMAIN=".vitorsierro.com"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Seeded on first `yarn workspace api prisma:seed` run. Use a strong password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Pluggy Open Finance — obtain these in the Pluggy dashboard; keep server-side.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Ai-memory: API server endpoint (host port 49374) and root bearer token.
# Keep the token only in infra/.env; it is never sent to the browser.
AI_MEMORY_URL="http://host.docker.internal:49374"
AI_MEMORY_AUTH_TOKEN=""

# Override to pin a Hermes version, or if you build the image locally.
HERMES_IMAGE="nousresearch/hermes-agent:latest"
