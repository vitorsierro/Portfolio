# Copy to infra/.env on the VPS and fill in. Never commit the filled version.

# Origins allowed to send credentialed requests (the Vercel site, apex + www).
# Never add draw./claw. here — see OriginCheckGuard in the API.
WEB_ORIGIN="https://vitorsierro.com,https://www.vitorsierro.com"

# Leading dot: shares the session cookie with the draw./claw. subdomains.
SESSION_COOKIE_DOMAIN=".vitorsierro.com"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Seeded on first `yarn workspace api prisma:seed` run. Use a strong password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Override if OpenClaw publishes its image elsewhere, or you build it locally.
OPENCLAW_IMAGE="ghcr.io/openclaw/openclaw:latest"
