{
  "name": "vitor-sierro-portfolio",
  "version": "1.0.0",
  "private": true,
  "resolutions": {
    "postcss": "^8.5.23",
    "**/@typescript-eslint/typescript-estree/minimatch": "11.0.8",
    "**/@nestjs/cli/glob": "14.0.6",
    "deepmerge-ts": "8.0.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"yarn workspace web dev\" \"yarn workspace api start:dev\"",
    "dev:web": "yarn workspace web dev",
    "dev:api": "yarn workspace api start:dev",
    "build": "yarn workspace api build && yarn workspace web build",
    "test": "yarn workspace web test && yarn workspace api test",
    "lint": "eslint apps/web apps/api",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "doctor": "npx --yes react-doctor@latest --no-supply-chain apps/web",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "globals": "^17.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
