# Server-side fetches (server components / SSR)
API_URL="http://localhost:3001"
# Client-side fetches (infinite scroll, admin CMS) — must be public
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Self-hosted tools on the VPS, gated by the nginx forward-auth check.
# These also define the allowlist for post-login ?next= redirects, and the
# /admin/draw + /admin/claw redirects. Leave empty to hide them from the hub.
# Prod example: https://draw.vitorsierro.com
NEXT_PUBLIC_DRAW_URL=""
NEXT_PUBLIC_CLAW_URL=""
