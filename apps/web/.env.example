# Server-side fetches (server components / SSR)
API_URL="http://localhost:3001"
# Client-side fetches (infinite scroll, admin CMS) — must be public
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Self-hosted tools on the VPS, gated by the nginx forward-auth check.
# These also define the allowlist for post-login ?next= redirects, and the
# /admin/hermes redirect.
#
# Local (ferramentas rodando nativamente):
#   NEXT_PUBLIC_DRAW_URL="http://localhost:8080"
#   NEXT_PUBLIC_HERMES_URL="http://localhost:9119"
# Produção (Vercel):
#   NEXT_PUBLIC_DRAW_URL="https://draw.vitorsierro.com"
#   NEXT_PUBLIC_HERMES_URL="https://chat.vitorsierro.com"
NEXT_PUBLIC_DRAW_URL="https://draw.vitorsierro.com"
NEXT_PUBLIC_HERMES_URL="https://chat.vitorsierro.com"
