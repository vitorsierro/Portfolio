# SQLite database (dev). In production use a disk-backed host or Turso/libSQL.
DATABASE_URL="file:./dev.db"

# JWT secrets — generate strong random values in production
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Seeded admin credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Server
PORT=3001
# Comma-separated list of web origins allowed to send credentialed requests
# (CORS + cookie-route Origin check). Prod example:
# "https://vitorsierro.com,https://www.vitorsierro.com"
# Never add the draw./claw. tool subdomains here.
WEB_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Domain shared by the admin_session cookie with the self-hosted tools
# (draw./claw. subdomains). Leave unset in dev — the cookie stays host-only.
SESSION_COOKIE_DOMAIN=""

# --- Módulo Enseada (CMS do site de temporada) ---
# Token que o site-enseada usa para ler GET /public/enseada/content.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENSEADA_CONTENT_TOKEN=""

# Avisa o site para revalidar quando o conteúdo muda. Opcional: sem isso o
# site ainda atualiza sozinho pelo ISR, só que mais devagar.
ENSEADA_REVALIDATE_URL=""
ENSEADA_REVALIDATE_SECRET=""

# Cloudinary — armazenamento das fotos do site.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
