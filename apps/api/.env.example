# SQLite database (dev). In production use a disk-backed host or Turso/libSQL.
DATABASE_URL="file:./dev.db"

# JWT secrets — generate strong random values in production
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Seeded admin credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Server
PORT=3001
# Comma-separated list of web origins allowed to send credentialed requests
# (CORS + cookie-route Origin check). Prod example:
# "https://vitorsierro.com,https://www.vitorsierro.com"
# Never add the draw./claw. tool subdomains here.
WEB_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Domain shared by the admin_session cookie with the self-hosted tools
# (draw./claw. subdomains). Leave unset in dev — the cookie stays host-only.
SESSION_COOKIE_DOMAIN=""
